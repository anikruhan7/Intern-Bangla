# Copy this file to .env and fill in real values. Never commit .env.

# App
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001
# Used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:3001

# PostgreSQL - either set DATABASE_URL (a single connection string, e.g.
# from Neon/Supabase/Render Postgres - takes priority when set), or the
# individual DB_* vars below (used for local Docker Postgres, no TLS).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=intern_bangla_db
# Only ever set true in local development. Never true in production.
DB_SYNCHRONIZE=true

# JWT - generate strong random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Mail (see MailModule for provider config)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Intern Bangla <no-reply@internbangla.com>"

# One-time admin bootstrap (used only by `npm run seed:admin`)
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_EMAIL=admin@internbangla.com
ADMIN_PASSWORD=change_me_before_running_seed

# pgAdmin4 (docker-compose)
PGADMIN_DEFAULT_EMAIL=admin@internbangla.com
PGADMIN_DEFAULT_PASSWORD=change_me

# Tommy (AI guide widget) - all optional. Without any of these, Tommy still
# works using Intern Bangla's own content + the free Wikipedia API, but
# can't hold a real free-form conversation. Tommy tries them in order:
# ANTHROPIC_API_KEY, then GEMINI_API_KEY, then DEEPSEEK_API_KEY.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Alternative engine - get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Third fallback engine - get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional extra source - get these from https://programmablesearchengine.google.com/ + Google Cloud Console
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

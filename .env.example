# Copy this file to .env and fill in real values. Never commit .env.

# App
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=intern_bangla_db
# Only ever set true in local development. Never true in production.
DB_SYNCHRONIZE=true

# JWT - generate strong random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (throttler)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Mail (see MailModule for provider config)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Intern Bangla <no-reply@internbangla.com>"

# One-time admin bootstrap (used only by `npm run seed:admin`)
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_EMAIL=admin@internbangla.com
ADMIN_PASSWORD=change_me_before_running_seed

# pgAdmin4 (docker-compose)
PGADMIN_DEFAULT_EMAIL=admin@internbangla.com
PGADMIN_DEFAULT_PASSWORD=change_me
